# Constants

# idle engine speed (rps)
define var fractional IDLE_RPS
var IDLE_RPS = 13.5

# starter cutoff speed (rps)
define var fractional STARTER_CUTOFF_RPS
var STARTER_CUTOFF_RPS = 6.5

# min idle throttle
define var fractional MIN_IDLE_THROTTLE
var MIN_IDLE_THROTTLE = 0.05

# max idle throttle
define var fractional MAX_IDLE_THROTTLE
var MAX_IDLE_THROTTLE = 0.3

# wheel base (m)
define var fractional WHEEL_BASE
var WHEEL_BASE = 2.72

# track width (m)
define var fractional TRACK_WIDTH
var TRACK_WIDTH = 1.52

# wheel radius (m)
define var fractional WHEEL_RADIUS
var WHEEL_RADIUS = 0.33

# pi
define var fractional PI
var PI = 3.14159265

# max virtual steer angle (rad)
define var fractional MAX_VIRTUAL_STEER_ANG
var MAX_VIRTUAL_STEER_ANG = 0.5236

# steer dead zone
define var fractional STEER_DEAD_ZONE
var STEER_DEAD_ZONE = 0.001

# derive inner angle at load
define var fractional MAX_INNER_STEER_ANGLE
var MAX_INNER_STEER_ANGLE = atan (var WHEEL_BASE / (var WHEEL_BASE / tan (var MAX_VIRTUAL_STEER_ANG) - var TRACK_WIDTH * 0.5))

# anti-stall engine rps
define var fractional ANTI_STALL_RPS
var ANTI_STALL_RPS = 9.0

# anti-stall brake release
define var fractional ANTI_STALL_RECOVER_BRAKE
var ANTI_STALL_RECOVER_BRAKE = 0.01

# launch control throttle
define var fractional LAUNCH_THROTTLE
var LAUNCH_THROTTLE = 0.95

# rear/front brake ratio (3/7)
define var fractional REAR_BRAKE_RATIO
var REAR_BRAKE_RATIO = 3.0 / 7.0

# autohold stop speed (rps)
define var fractional AUTOHOLD_STOP_RPS
var AUTOHOLD_STOP_RPS = 0.1

# autohold release throttle
define var fractional AUTOHOLD_RELEASE_THROTTLE
var AUTOHOLD_RELEASE_THROTTLE = 0.1

# abs min brake pedal
define var fractional ABS_MIN_BRAKE
var ABS_MIN_BRAKE = 0.2

# abs target speed ratio
define var fractional ABS_TARGET_SPEED_RATIO
var ABS_TARGET_SPEED_RATIO = 0.8

# abs min reference speed
define var fractional ABS_MIN_SPEED_RPS
var ABS_MIN_SPEED_RPS = 0.5

# rpm dial max (rps)
define var fractional DIAL_RPM_MAX
var DIAL_RPM_MAX = 150.0

# speed dial max (km/h)
define var fractional DIAL_SPEED_MAX
var DIAL_SPEED_MAX = 240.0

# rpm per rps
define var fractional RPM_PER_RPS
var RPM_PER_RPS = 60.0

# upshift curve exponent
define var fractional SHIFT_CURVE_K
var SHIFT_CURVE_K = 1.5

# gear ratio step next/current
define var fractional GEAR_RATIO_STEP
var GEAR_RATIO_STEP = 0.72

# coasting hysteresis
define var fractional HYSTERESIS_MAX
var HYSTERESIS_MAX = 0.15

# full throttle hysteresis
define var fractional HYSTERESIS_MIN
var HYSTERESIS_MIN = 0.03

# brake downshift assist min
define var fractional BRAKE_DOWNSHIFT_MIN
var BRAKE_DOWNSHIFT_MIN = 0.05

# brake downshift assist gain
define var fractional BRAKE_DOWNSHIFT_GAIN
var BRAKE_DOWNSHIFT_GAIN = 0.8

# upshift base rpm, 0 unused
define list fractional UPSHIFT_BASE
var UPSHIFT_BASE append (0.0)
var UPSHIFT_BASE append (1500.0)
var UPSHIFT_BASE append (1800.0)
var UPSHIFT_BASE append (2000.0)
var UPSHIFT_BASE append (2200.0)
var UPSHIFT_BASE append (2400.0)

# upshift limit rpm, 0 unused
define list fractional UPSHIFT_LIMIT
var UPSHIFT_LIMIT append (0.0)
var UPSHIFT_LIMIT append (3000.0)
var UPSHIFT_LIMIT append (3500.0)
var UPSHIFT_LIMIT append (3900.0)
var UPSHIFT_LIMIT append (4200.0)
var UPSHIFT_LIMIT append (4400.0)


# Globals

# Btn_Start_Stop Press flag
define var bool lastStartStopPressd
var lastStartStopPressd = false

# power & lights state
# 0 -> off
# 1 -> main switch on
# 2 -> engine on
define var integer powerState
var powerState = 0

# transmission selected gear
define var integer targetGear
var targetGear = 0

# transmission last stick
define var integer lastGearMode
var lastGearMode = 0

# last paddle value
define var fractional lastPaddle
var lastPaddle = 0.0

# gearbox pulse cooldown
define var bool gearboxPulseCooldown
var gearboxPulseCooldown = false

# anti-stall active flag
define var bool antiStall
var antiStall = false

# handbrake latched state
# init to true
define var bool handbrakeActive
var handbrakeActive = true

# handbrake btn last state
define var bool lastHandbrakePressed
var lastHandbrakePressed = false

# autohold mode enabled
define var bool autoholdEnabled
var autoholdEnabled = false

# autohold btn last state
define var bool lastAutoholdPressed
var lastAutoholdPressed = false

# autohold holding brake
define var bool autoholdActive
var autoholdActive = false

# effective brake pedal (0-1)
define var fractional brakePedal
var brakePedal = 0.0

# abs enabled (default on)
define var bool absEnabled
var absEnabled = true

# abs btn last state
define var bool lastABSPressed
var lastABSPressed = false

# bool -> 1.0 / 0.0
define function bool_to_fraction (bool value, fractional result)
{
	if (param value)
	{
		param result = 1.0
	}
	else
	{
		param result = 0.0
	}
}

# clamp value to min - max
define function clamp (fractional inputValue, fractional minValue, fractional maxValue, fractional clampedResult)
{
	if (param inputValue < param minValue)
	{
		param clampedResult = param minValue
	}
	elseif (param inputValue > param maxValue)
	{
		param clampedResult = param maxValue
	}
	else
	{
		param clampedResult = param inputValue
	}
}

# map value range to +-0.95
define function dial_map (fractional dialInput, fractional dialMin, fractional dialMax, fractional dialResult)
{
	param dialResult = (param dialInput - param dialMin) / (param dialMax - param dialMin) * 1.9 - 0.95
	if (param dialResult < -0.95)
	{
		param dialResult = -0.95
	}
	elseif (param dialResult > 0.95)
	{
		param dialResult = 0.95
	}
}

# upshift rpm by gear
define function upshift_rpm (integer curGear1, fractional pedalInput1, fractional upShiftRpmResult)
{
	param upShiftRpmResult = var UPSHIFT_BASE[param curGear1] + (var UPSHIFT_LIMIT[param curGear1] - var UPSHIFT_BASE[param curGear1]) * (param pedalInput1 ^ var SHIFT_CURVE_K)
}

# minimal safe downshift gear
define function downshift_target (integer curGear3, fractional pedalInput3, fractional rpmNow, integer downGearResult)
{
	define var integer checkGear
	define var integer lastGear
	define var integer exponentGear
	define var fractional checkUpRpm
	define var fractional ratioPow
	define var bool found
	var checkGear = 1
	var lastGear = param curGear3 - 1
	var found = false
	param downGearResult = param curGear3
	repeat (var lastGear)
	{
		if (! (var found))
		{
			call upshift_rpm (var checkGear, param pedalInput3, var checkUpRpm)
			var exponentGear = param curGear3 - var checkGear
			var ratioPow = var GEAR_RATIO_STEP ^ to_fractional (var exponentGear)
			if (param rpmNow < (var checkUpRpm / var RPM_PER_RPS) * var ratioPow * (1.0 - (var HYSTERESIS_MAX - (var HYSTERESIS_MAX - var HYSTERESIS_MIN) * param pedalInput3)))
			{
				param downGearResult = var checkGear
				var found = true
			}
		}
		var checkGear = var checkGear + 1
	}
}

# power state machine
define function power_on_tick ()
{
	requires (out Btn_Start_Stop.is_pressed)
	{
		if (out Btn_Start_Stop.is_pressed && ! (var lastStartStopPressd))
		{
			if (var powerState == 0)
			{
				if (var brakePedal > 0.5)
				{
					var powerState = 2
				}
				else
				{
					var powerState = 1
				}
			}
			elseif (var powerState == 1)
			{
				if (var brakePedal > 0.5)
				{
					var powerState = 2
				}
				else
				{
					var powerState = 0
				}
			}
			elseif (var powerState == 2)
			{
				var powerState = 0
			}
		}
		var lastStartStopPressd = out Btn_Start_Stop.is_pressed
	}

	define var bool mainOn
	var mainOn = var powerState > 0

	define var fractional mainValue
	define var fractional engineValue
	call bool_to_fraction (var mainOn, var mainValue)
	call bool_to_fraction (var powerState == 2, var engineValue)

	requires (in ASM_Power_Main.input)
	{
		in ASM_Power_Main.input = var mainValue
	}
	requires (in ASM_Power_Engine.input)
	{
		in ASM_Power_Engine.input = var engineValue
	}

	requires (in Btn_Start_Stop.is_illuminated)
	{
		in Btn_Start_Stop.is_illuminated = var mainOn
	}
	requires (in Dial_RPM.is_illuminated)
	{
		in Dial_RPM.is_illuminated = var mainOn
	}
	requires (in Dial_Speed.is_illuminated)
	{
		in Dial_Speed.is_illuminated = var mainOn
	}
	requires (in Display_Gear.is_illuminated)
	{
		in Display_Gear.is_illuminated = var mainOn
	}
}

# engine logic
define function engine_on_tick ()
{
	define var fractional starterValue
	define var fractional throttleValue
	var starterValue = 0.0
	var throttleValue = 0.0

	requires (out Engine.rps)
	{
		if (var powerState == 2)
		{
			requires (out Steering_Wheel.right_pedal)
			{
				define var fractional rawMinimal
				define var fractional rawThrottle

				call bool_to_fraction (out Engine.rps < var STARTER_CUTOFF_RPS, var starterValue)

				var rawMinimal = (var IDLE_RPS - out Engine.rps) * 0.2
				if (! (var targetGear == 0) && (var brakePedal > var ANTI_STALL_RECOVER_BRAKE) && ! (var antiStall))
				{
					var rawMinimal = var MIN_IDLE_THROTTLE
				}
				call clamp (var rawMinimal, var MIN_IDLE_THROTTLE, var MAX_IDLE_THROTTLE, var rawThrottle)
				requires (out Gearbox.clutch_factor)
				{
					var rawThrottle = var rawThrottle + (1.0 - var rawThrottle) * out Steering_Wheel.right_pedal * (0.2 + 0.8 * out Gearbox.clutch_factor)
				}
				call clamp (var rawThrottle, var MIN_IDLE_THROTTLE, 1.0, var throttleValue)
			}
		}
		# rpm dial
		define var fractional rpmDial
		call dial_map (out Engine.rps, 0.0, var DIAL_RPM_MAX, var rpmDial)
		requires (in Dial_RPM.display_value)
		{
			in Dial_RPM.display_value = var rpmDial
		}
	}

	requires (in ASM_Power_Starter.input)
	{
		in ASM_Power_Starter.input = var starterValue
	}
	requires (in ASM_Throttle.input)
	{
		in ASM_Throttle.input = var throttleValue
	}
}

# transmission logic
define function transmission_on_tick ()
{
	# gear stick selection
	requires (out Gear_Stick.throttle)
	{
		if (out Gear_Stick.throttle == 0)
		{
			# neutral
			var targetGear = 0
			var antiStall = false
		}
		elseif (out Gear_Stick.throttle == 1)
		{
			# reverse
			if (! (var targetGear == -1))
			{
				var antiStall = true
			}
			var targetGear = -1
		}
		elseif (out Gear_Stick.throttle == 2)
		{
			# drive
			if (! (var lastGearMode == 2))
			{
				# from other modes to drive
				if (var targetGear < 1)
				{
					# not manual
					var antiStall = true
					var targetGear = 1
				}
			}
			else
			{
				if (var antiStall)
				{
					var targetGear = 1
				}
				else
				{
					requires (out Engine.rps)
					{
						requires (out Steering_Wheel.right_pedal)
						{
							requires (out Gearbox.current_gear)
							{
								requires (out Gearbox.target_gear)
								{
									requires (out Gearbox.clutch_factor)
									{
										if ((out Gearbox.clutch_factor >= 1.0) && (out Gearbox.current_gear == out Gearbox.target_gear) && (var targetGear >= 1) && (var targetGear <= 6))
										{
											define var fractional upRpm
											define var bool canUp
											define var integer downTargetGear
											var canUp = false
											var downTargetGear = var targetGear

											if ((var targetGear < 6) && (var brakePedal <= var BRAKE_DOWNSHIFT_MIN))
											{
												call upshift_rpm (var targetGear, out Steering_Wheel.right_pedal, var upRpm)
												if (out Engine.rps > (var upRpm / var RPM_PER_RPS))
												{
													var canUp = true
												}
											}
											if (! (var canUp) && var targetGear > 1)
											{
												define var fractional downTheta
												var downTheta = out Steering_Wheel.right_pedal
												if ((var brakePedal > var BRAKE_DOWNSHIFT_MIN) && ((var brakePedal * var BRAKE_DOWNSHIFT_GAIN) > var downTheta))
												{
													var downTheta = var brakePedal * var BRAKE_DOWNSHIFT_GAIN
												}
												call downshift_target (var targetGear, var downTheta, out Engine.rps, var downTargetGear)
											}

											if (var canUp)
											{
												var targetGear = var targetGear + 1
											}
											elseif (var downTargetGear < var targetGear)
											{
												var targetGear = var downTargetGear
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		elseif (out Gear_Stick.throttle == 3)
		{
			# manual
			if (! (var lastGearMode == 3))
			{
				# from other modes to manual
				if (var targetGear < 1)
				{
					# not drive
					var antiStall = true
					var targetGear = 1
				}
			}
			else
			{
				# already in manual
				# paddle shifts (manual only)
				define var bool paddleUp
				define var bool paddleDown
				var paddleUp = false
				var paddleDown = false

				requires (out Paddle_Shift.throttle)
				{
					var paddleUp = (out Paddle_Shift.throttle > 0.5) && (var lastPaddle <= 0.5)
					var paddleDown = (out Paddle_Shift.throttle < -0.5) && (var lastPaddle >= -0.5)
					var lastPaddle = out Paddle_Shift.throttle
				}
				if (var paddleUp)
				{
					var targetGear = var targetGear + 1
				}
				elseif (var paddleDown)
				{
					var targetGear = var targetGear - 1
				}
				if (var targetGear > 6)
				{
					var targetGear = 6
				}
				if (var targetGear < 1)
				{
					var targetGear = 1
				}
			}
		}
		var lastGearMode = out Gear_Stick.throttle
	}

	if (var antiStall)
	{
		requires (out Steering_Wheel.right_pedal)
		{
			if ((var brakePedal < var ANTI_STALL_RECOVER_BRAKE) || (out Steering_Wheel.right_pedal > var LAUNCH_THROTTLE))
			{
				var antiStall = false
			}
		}
	}
	if (! (var targetGear == 0) && ! (var antiStall))
	{
		requires (out Engine.rps)
		{
			if (out Engine.rps < var ANTI_STALL_RPS)
			{
				var antiStall = true
			}
		}
	}

	define var integer desiredGear
	if (var antiStall)
	{
		var desiredGear = 0
	}
	else
	{
		var desiredGear = var targetGear
	}

	# desired reducer
	requires (in ASM_Reducer_A.input)
	{
		requires (in ASM_Reducer_B.input)
		{
			if (var targetGear >= 4)
			{
				in ASM_Reducer_A.input = 1.0
				in ASM_Reducer_B.input = 0.0
			}
			else
			{
				in ASM_Reducer_A.input = 0.0
				in ASM_Reducer_B.input = 1.0
			}
		}
	}

	# desired gearbox gear
	define var integer desiredGearboxGear
	if (var desiredGear <= 3)
	{
		var desiredGearboxGear = var desiredGear
	}
	else
	{
		var desiredGearboxGear = var desiredGear - 3
	}

	# gearbox pulse
	define var fractional gearboxCommand
	var gearboxCommand = 0.0
	if (var gearboxPulseCooldown)
	{
		var gearboxPulseCooldown = false
		var gearboxCommand = 0.0
	}
	else
	{
		requires (out Gearbox.target_gear)
		{
			if (out Gearbox.target_gear < var desiredGearboxGear)
			{
				var gearboxCommand = 1.0
				var gearboxPulseCooldown = true
			}
			elseif (out Gearbox.target_gear > var desiredGearboxGear)
			{
				var gearboxCommand = -1.0
				var gearboxPulseCooldown = true
			}
		}
	}

	# gearbox output
	requires (in ASM_Gearbox.input)
	{
		in ASM_Gearbox.input = var gearboxCommand
	}

	# gear display
	define var fractional gearDisplay
	var gearDisplay = 9.0
	if (! (var targetGear == -1))
	{
		var gearDisplay = to_fractional (var targetGear)
	}
	requires (in Display_Gear.display_value)
	{
		in Display_Gear.display_value = var gearDisplay
	}
}

# brake logic
define function brake_on_tick ()
{
	# handbrake button (latching)
	requires (out Btn_Handbrake.is_pressed)
	{
		if (out Btn_Handbrake.is_pressed && ! (var lastHandbrakePressed))
		{
			var handbrakeActive = ! (var handbrakeActive)
		}
		var lastHandbrakePressed = out Btn_Handbrake.is_pressed
	}

	# autohold reset on power off
	if (var powerState == 0)
	{
		var autoholdEnabled = false
		var autoholdActive = false
	}

	# autohold button (latching)
	requires (out Btn_Autohold.is_pressed)
	{
		if ((var powerState > 0) && out Btn_Autohold.is_pressed && ! (var lastAutoholdPressed))
		{
			var autoholdEnabled = ! (var autoholdEnabled)
		}
		var lastAutoholdPressed = out Btn_Autohold.is_pressed
	}

	# abs button (latching)
	requires (out Btn_ABS.is_pressed)
	{
		if (out Btn_ABS.is_pressed && ! (var lastABSPressed))
		{
			var absEnabled = ! (var absEnabled)
		}
		var lastABSPressed = out Btn_ABS.is_pressed
	}

	# wheel speed (rps)
	define var fractional wheelFlSpeed
	define var fractional wheelFrSpeed
	define var fractional wheelRlSpeed
	define var fractional wheelRrSpeed
	var wheelFlSpeed = 0.0
	var wheelFrSpeed = 0.0
	var wheelRlSpeed = 0.0
	var wheelRrSpeed = 0.0

	requires (out Wheel_FL.rps)
	{
		requires (out Wheel_FR.rps)
		{
			requires (out Wheel_RL.rps)
			{
				requires (out Wheel_RR.rps)
				{
					var wheelFlSpeed = abs (out Wheel_FL.rps)
					var wheelFrSpeed = abs (out Wheel_FR.rps)
					var wheelRlSpeed = abs (out Wheel_RL.rps)
					var wheelRrSpeed = abs (out Wheel_RR.rps)
				}
			}
		}
	}

	# autohold activation
	if (! (var autoholdEnabled))
	{
		var autoholdActive = false
	}
	elseif (var powerState > 0)
	{
		requires (out Steering_Wheel.right_pedal)
		{
			if (out Steering_Wheel.right_pedal > var AUTOHOLD_RELEASE_THROTTLE)
			{
				var autoholdActive = false
			}
			else
			{
				if ((var wheelFlSpeed < var AUTOHOLD_STOP_RPS) && (var wheelFrSpeed < var AUTOHOLD_STOP_RPS) && (var wheelRlSpeed < var AUTOHOLD_STOP_RPS) && (var wheelRrSpeed < var AUTOHOLD_STOP_RPS))
				{
					var autoholdActive = true
				}
			}
		}
	}

	# brake pedal proxy
	requires (out Steering_Wheel.left_pedal)
	{
		var brakePedal = out Steering_Wheel.left_pedal
	}
	if (var autoholdActive)
	{
		var brakePedal = 1.0
	}

	# abs
	define var fractional absFactorFL
	define var fractional absFactorFR
	define var fractional absFactorRL
	define var fractional absFactorRR
	define var bool absTriggered
	var absFactorFL = 1.0
	var absFactorFR = 1.0
	var absFactorRL = 1.0
	var absFactorRR = 1.0
	var absTriggered = false

	if ((var absEnabled) && (var brakePedal > var ABS_MIN_BRAKE))
	{
		define var fractional absRefSpeed
		var absRefSpeed = var wheelFlSpeed
		if (var wheelFrSpeed > var absRefSpeed)
		{
			var absRefSpeed = var wheelFrSpeed
		}
		if (var wheelRlSpeed > var absRefSpeed)
		{
			var absRefSpeed = var wheelRlSpeed
		}
		if (var wheelRrSpeed > var absRefSpeed)
		{
			var absRefSpeed = var wheelRrSpeed
		}

		if (var absRefSpeed > var ABS_MIN_SPEED_RPS)
		{
			define var fractional absTargetSpeed
			var absTargetSpeed = var ABS_TARGET_SPEED_RATIO * var absRefSpeed

			if (var wheelFlSpeed < var absTargetSpeed)
			{
				var absFactorFL = 0.0
			}
			if (var wheelFrSpeed < var absTargetSpeed)
			{
				var absFactorFR = 0.0
			}
			if (var wheelRlSpeed < var absTargetSpeed)
			{
				var absFactorRL = 0.0
			}
			if (var wheelRrSpeed < var absTargetSpeed)
			{
				var absFactorRR = 0.0
			}

			var absTriggered = (var absFactorFL == 0.0) || (var absFactorFR == 0.0) || (var absFactorRL == 0.0) || (var absFactorRR == 0.0)
		}
	}

	# speed dial
	define var fractional speedKmh
	var speedKmh = (var wheelFlSpeed + var wheelFrSpeed + var wheelRlSpeed + var wheelRrSpeed) * 0.25 * 2.0 * var PI * var WHEEL_RADIUS * 3.6
	define var fractional speedDial
	call dial_map (var speedKmh, 0.0, var DIAL_SPEED_MAX, var speedDial)
	requires (in Dial_Speed.display_value)
	{
		in Dial_Speed.display_value = var speedDial
	}

	# brake pressures
	define var fractional rearPressure
	var rearPressure = var brakePedal * var REAR_BRAKE_RATIO
	if (var handbrakeActive)
	{
		var rearPressure = 1.0
	}
	requires (in ASM_Brake_FL.input)
	{
		in ASM_Brake_FL.input = var brakePedal * var absFactorFL
	}
	requires (in ASM_Brake_FR.input)
	{
		in ASM_Brake_FR.input = var brakePedal * var absFactorFR
	}
	requires (in ASM_Brake_RL.input)
	{
		in ASM_Brake_RL.input = var rearPressure * var absFactorRL
	}
	requires (in ASM_Brake_RR.input)
	{
		in ASM_Brake_RR.input = var rearPressure * var absFactorRR
	}

	# button lights
	requires (in Btn_Handbrake.is_illuminated)
	{
		in Btn_Handbrake.is_illuminated = (var handbrakeActive) && (var powerState > 0)
	}
	requires (in Btn_Autohold.is_illuminated)
	{
		in Btn_Autohold.is_illuminated = (var autoholdEnabled) && (var powerState > 0)
	}
	requires (in Btn_ABS.is_illuminated)
	{
		in Btn_ABS.is_illuminated = (! (var absEnabled)) || (var absTriggered)
	}
}

# ackermann steering logic
define function steering_on_tick ()
{
	define var fractional steerInput
	define var fractional virtualSteerRadius
	define var fractional innerNorm
	define var fractional outerNorm
	define var fractional leftSteeringVal
	define var fractional rightSteeringVal

	var leftSteeringVal = 0.0
	var rightSteeringVal = 0.0

	requires (out Steering_Wheel.steering)
	{
		var steerInput = out Steering_Wheel.steering
		if (abs (var steerInput) < var STEER_DEAD_ZONE)
		{
			var leftSteeringVal = 0.0
			var rightSteeringVal = 0.0
		}
		else
		{
			var virtualSteerRadius = var WHEEL_BASE / tan (abs (var steerInput) * var MAX_VIRTUAL_STEER_ANG)
			var innerNorm = atan (var WHEEL_BASE / (var virtualSteerRadius - var TRACK_WIDTH * 0.5)) / var MAX_INNER_STEER_ANGLE
			var outerNorm = atan (var WHEEL_BASE / (var virtualSteerRadius + var TRACK_WIDTH * 0.5)) / var MAX_INNER_STEER_ANGLE
			if (var steerInput > 0.0)
			{
				# right wheel = inner
				var rightSteeringVal = var innerNorm
				var leftSteeringVal = 0.0 - var outerNorm
			}
			else
			{
				# left wheel = inner
				var leftSteeringVal = var innerNorm
				var rightSteeringVal = 0.0 - var outerNorm
			}
		}
	}

	requires (in ASM_Steering_Left.input)
	{
		in ASM_Steering_Left.input = var leftSteeringVal
	}
	requires (in ASM_Steering_Right.input)
	{
		in ASM_Steering_Right.input = var rightSteeringVal
	}
}

# door latch logic
define function door_lock_on_tick ()
{
	define var fractional latchValue

	requires (out Door_Lock.is_pressed)
	{
		requires (out FL_Door_Handle.is_active)
		{
			requires (in ASM_FL_Door_Latch.input)
			{
				call bool_to_fraction (out FL_Door_Handle.is_active && ! (out Door_Lock.is_pressed), var latchValue)
				in ASM_FL_Door_Latch.input = var latchValue
			}
		}

		requires (out FR_Door_Handle.is_active)
		{
			requires (in ASM_FR_Door_Latch.input)
			{
				call bool_to_fraction (out FR_Door_Handle.is_active && ! (out Door_Lock.is_pressed), var latchValue)
				in ASM_FR_Door_Latch.input = var latchValue
			}
		}

		requires (out RL_Door_Handle.is_active)
		{
			requires (in ASM_RL_Door_Latch.input)
			{
				call bool_to_fraction (out RL_Door_Handle.is_active && ! (out Door_Lock.is_pressed), var latchValue)
				in ASM_RL_Door_Latch.input = var latchValue
			}
		}

		requires (out RR_Door_Handle.is_active)
		{
			requires (in ASM_RR_Door_Latch.input)
			{
				call bool_to_fraction (out RR_Door_Handle.is_active && ! (out Door_Lock.is_pressed), var latchValue)
				in ASM_RR_Door_Latch.input = var latchValue
			}
		}

		requires (out Trunk_Handle.is_active)
		{
			requires (in ASM_Trunk_Latch.input)
			{
				call bool_to_fraction (out Trunk_Handle.is_active && ! (out Door_Lock.is_pressed), var latchValue)
				in ASM_Trunk_Latch.input = var latchValue
			}
		}

		requires (out Hood_Handle.is_active)
		{
			requires (in ASM_Hood_Latch.input)
			{
				call bool_to_fraction (out Hood_Handle.is_active && ! (out Door_Lock.is_pressed), var latchValue)
				in ASM_Hood_Latch.input = var latchValue
			}
		}
	}
}

on_tick
{
	call power_on_tick ()
	call brake_on_tick ()
	call transmission_on_tick ()
	call engine_on_tick ()
	call steering_on_tick ()
	call door_lock_on_tick ()
}
