{
  "name": "anymaker-scripting",
  "displayName": "AnyMaker Scripting",
  "description": "Syntax highlighting, scope-aware coloring, diagnostics, snippets, and IntelliSense for AnyMaker .amc scripts",
  "version": "0.11.0",
  "publisher": "local",
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onLanguage:anymaker"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "anymaker",
    "amc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "anymaker",
        "aliases": [
          "AnyMaker",
          "anymaker"
        ],
        "extensions": [
          ".amc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/anymaker.svg",
          "dark": "./icons/anymaker.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "anymaker",
        "scopeName": "source.amc",
        "path": "./syntaxes/anymaker.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "anymaker",
        "path": "./snippets/anymaker.json"
      }
    ]
  }
}
